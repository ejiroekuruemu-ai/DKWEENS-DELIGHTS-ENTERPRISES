# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BUSINESS_ALERT_EMAIL: The destination email address for all booking, enquiry, and review notifications.
# Defaults to official business address: ejiroekuruemu@gmail.com
BUSINESS_ALERT_EMAIL="ejiroekuruemu@gmail.com"

# SMTP Configuration: Required for live dispatch of customer booking and review email notifications.
# If unconfigured, notifications are reliably recorded in the Admin Notification Center with status 'unconfigured_simulated' and can be retried once SMTP is supplied.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="ejiroekuruemu@gmail.com"
SMTP_PASS="your_app_specific_password_here"
SMTP_FROM="DKWEENS DELIGHTS ENTERPRISES <ejiroekuruemu@gmail.com>"
